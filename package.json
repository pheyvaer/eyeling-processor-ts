{
    "name": "eyeling-processor-ts",
    "version": "0.0.1",
    "description": "Use Eyeling via a TypeScript RDF-Connect processor.",
    "type": "module",
    "main": "lib/index.js",
    "files": [
        "lib/**/*",
        "processor.ttl"
    ],
    "scripts": {
        "build": "tsc && tsc-alias && npx rdfc-shacl2owl '*.ttl' lib/",
        "test": "vitest run --coverage --coverage.include src",
        "prepare": "husky",
        "lint:markdown": "markdownlint-cli2",
        "lint:markdown:fix": "markdownlint-cli2 --fix"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pheyvaer/eyeling-processor-ts"
    },
    "author": "Pieter Heyvaert (https://pieterheyvaert.com/#me)",
    "license": "MIT",
    "devDependencies": {
        "@rdfc/js-runner": "^3.2.0",
        "@types/node": "^26.1.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitest/coverage-v8": "^4.1.10",
        "dotenv": "^17.4.2",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "n3": "^2.2.0",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "markdownlint-cli2": "^0.16.0"
    },
    "dependencies": {
        "eyeling": "^2.35.4",
        "winston": "^3.19.0"
    }
}
